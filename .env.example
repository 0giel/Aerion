# Copy to .env (never commit .env). All values are optional.

# Azure application (client) ID for Microsoft login. Must be approved by Mojang,
# see docs/AZURE_SETUP.md. Can also be set in Settings -> Accounts.
LAUNCHER_MSA_CLIENT_ID=

# CurseForge API key (personal; apply at https://console.curseforge.com).
# Can also be entered in Settings -> Mods (stored in the OS keyring).
CURSEFORGE_API_KEY=

# Build-time identity for the Modrinth User-Agent: "<author>/aerion/<version> (<contact>)".
# Modrinth asks for a contact (e-mail or project URL).
AERION_UA_AUTHOR=
AERION_UA_CONTACT=

# Debug builds only: allow offline accounts without a Microsoft account (automated tests).
LAUNCHER_DEV_OFFLINE=
