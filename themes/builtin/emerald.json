{
  "$schema": "../theme.schema.json",
  "id": "emerald",
  "name": "Emerald",
  "author": "Aerion",
  "base": "dark",
  "colors": {
    "bg": "#16171b",
    "surface": "#1f2026",
    "surface2": "#272930",
    "surface3": "#31333b",
    "border": "#ffffff17",
    "text": "#ecebf3",
    "textMuted": "#a9a8b6",
    "textFaint": "#74737f",
    "accent": "#34d399",
    "accentText": "#04261a",
    "success": "#4ade80",
    "warning": "#fbbf24",
    "danger": "#f87171",
    "info": "#60a5fa",
    "focus": "#6ee7b7"
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "xl": 22
  },
  "font": {
    "family": "system",
    "mono": "system-mono",
    "size": 14
  },
  "density": "comfortable",
  "layout": {
    "sidebar": "left",
    "scale": 1
  },
  "effects": {
    "blur": 18,
    "glass": 0.72,
    "shadow": 0.45
  },
  "motion": {
    "enabled": true,
    "speed": 1
  },
  "background": {
    "type": "gradient",
    "color": "#141716",
    "gradient": "radial-gradient(1100px 650px at 85% 0%, #17322a 0%, transparent 60%), linear-gradient(160deg, #181b1a 0%, #121413 100%)",
    "asset": null,
    "dim": 0,
    "blur": 0,
    "ribbons": true,
    "particles": "dust"
  }
}
