{
  "id": "cherry",
  "name": "Cherry Blossom",
  "author": "Aerion",
  "base": "dark",
  "colors": {
    "bg": "#1a1418",
    "surface": "#241b21",
    "surface2": "#2e232a",
    "surface3": "#3a2c35",
    "border": "#ffffff17",
    "text": "#f6e9ef",
    "textMuted": "#c3a9b6",
    "textFaint": "#8c7480",
    "accent": "#f49ac1",
    "accentText": "#3a0f22",
    "success": "#4ade80",
    "warning": "#fbbf24",
    "danger": "#f87171",
    "info": "#60a5fa",
